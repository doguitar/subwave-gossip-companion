GOSSIP_BASE_DIR=.
GOSSIP_TYPES_PATH=gossip-types.json
SUBWAVE_API_URL=
SUBWAVE_API_USER=
SUBWAVE_API_PASSWORD=
SUBWAVE_API_TOKEN=
PROVIDER=openai
PROVIDER_KEY=
PROVIDER_MODEL=gpt-4o-mini
# Optional reasoning/thinking depth (off when unset or blank). Alias: GOSSIP_LLM_THINKING
# Examples: low, medium, high, max, or proxy-specific tokens
PROVIDER_THINKING=
OPENAI_BASE_URL=https://api.openai.com/v1
# Default refresh maximum (integer 1-10); low values may leave the roster incomplete.
GOSSIP_REFRESH_COUNT=1
# Required separate operator secret for POST /refresh and /gossip/refresh.
GOSSIP_REFRESH_SECRET=
# At most this many refreshes run at once (integer 1-10).
GOSSIP_REFRESH_MAX_CONCURRENCY=1
# Minimum milliseconds between admitted refreshes (integer 0-3600000).
GOSSIP_REFRESH_MIN_INTERVAL_MS=60000
# Maximum JSON request body size for POST /refresh and /gossip/refresh (bytes, 1-1048576).
GOSSIP_REFRESH_BODY_MAX_BYTES=16384
# HTTP deadline to receive request headers (milliseconds, 1000-300000).
GOSSIP_HEADERS_TIMEOUT_MS=10000
# HTTP deadline to receive a complete request, including its body (milliseconds, 1000-300000).
GOSSIP_REQUEST_TIMEOUT_MS=30000
GOSSIP_HOST=0.0.0.0
GOSSIP_PORT=8080
GOSSIP_STATE_PATH=data/gossip-state.json
GOSSIP_SEED_CAP=5
GOSSIP_HISTORY_GENERATIONS=7
GOSSIP_REVIEW_ROUNDS=0
GOSSIP_THREAD_MAX_TELLINGS=3
GOSSIP_THREAD_MAX_AGE_MS=86400000
GOSSIP_FEED_BASE_URL=http://127.0.0.1:8080
GOSSIP_MIN_RUMOR_LENGTH=20
GOSSIP_TIMEZONE=America/Los_Angeles
GOSSIP_LLM_FIXTURE=
GOSSIP_LLM_CALL_LOG=logs/llm-calls.jsonl
GOSSIP_OPERATIONAL_LOG=logs/gossip.log
